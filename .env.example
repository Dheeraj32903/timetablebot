# Telegram
TELEGRAM_BOT_TOKEN=YOUR_BOT_TOKEN_HERE
# Comma-separated list of authorized Telegram user IDs. Leave empty to allow all users.
AUTHORIZED_TELEGRAM_USER_IDS=6986045748,7337604045,7436134692,7148872598,7765177891,6501348586

# ERP
ERP_BASE_URL=https://newerp.kluniversity.in
ERP_LOGIN_URL=https://newerp.kluniversity.in/index.php?r=site%2Flogin
ERP_TIMETABLE_URL=https://newerp.kluniversity.in/index.php?r=timetables%2Funiversitymasteracademictimetableview%2Findividualstudenttimetableget&UniversityMasterAcademicTimetableView%5Bacademicyear%5D=29&UniversityMasterAcademicTimetableView%5Bsemesterid%5D=1
ERP_TIMETABLE_REFERER_URL=https://newerp.kluniversity.in/index.php?r=timetables%2Funiversitymasteracademictimetableview%2Findexstudentindisearch
ERP_USER_AGENT=Mozilla/5.0 (Linux; Android 15; Pixel 9) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/151.0.0.0 Mobile Safari/537.36

# Optional fallback credentials. If not set here, the bot will ask for them in Telegram chat.
ERP_USERNAME=
ERP_PASSWORD=

# Daily automatic morning timetable message time (IST, 24-hour format).
MORNING_TIMETABLE_HOUR=7
MORNING_TIMETABLE_MINUTE=0

# Maximum automated login retry attempts for CAPTCHA solving (default: 10)
LOGIN_MAX_RETRIES=10

# MongoDB Database (Atlas Cloud or Local) - Ensures persistent logins across redeployments
# Example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=
MONGODB_DB_NAME=klu_timetable_bot

# Encryption key for stored ERP credentials in credentials.json.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# If left empty, a stable key derived from your TELEGRAM_BOT_TOKEN is used.
CREDENTIALS_ENCRYPTION_KEY=

